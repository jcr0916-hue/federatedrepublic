{
  "version": 2,
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "builds": [
    {
      "src": "api/navigator.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30,
        "includeFiles": [
          "constitution_data.json"
        ]
      }
    },
    {
      "src": "api/annotate.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30,
        "includeFiles": [
          "constitution_data.json",
          "annotation-history.json",
          "annotations.json"
        ]
      }
    },
    {
      "src": "api/annotations-generate.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 300,
        "includeFiles": [
          "constitution_data.json",
          "annotation-history.json",
          "annotations.json"
        ]
      }
    },
    {
      "src": "api/crossroads.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30
      }
    },
    {
      "src": "api/newsroom-run.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 300
      }
    },
    {
      "src": "api/newsroom-triage.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 180
      }
    },
    {
      "src": "api/newsroom-inbox.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30
      }
    },
    {
      "src": "api/newsroom-read.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30
      }
    },
    {
      "src": "api/newsroom-ask.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 300
      }
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "_site"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/navigator",
      "dest": "/api/navigator.js"
    },
    {
      "src": "/api/annotate",
      "dest": "/api/annotate.js"
    },
    {
      "src": "/api/annotations-generate",
      "dest": "/api/annotations-generate.js"
    },
    {
      "src": "/api/crossroads",
      "dest": "/api/crossroads.js"
    },
    {
      "src": "/api/newsroom-run",
      "dest": "/api/newsroom-run.js"
    },
    {
      "src": "/api/newsroom-triage",
      "dest": "/api/newsroom-triage.js"
    },
    {
      "src": "/api/newsroom-inbox",
      "dest": "/api/newsroom-inbox.js"
    },
    {
      "src": "/api/newsroom-read",
      "dest": "/api/newsroom-read.js"
    },
    {
      "src": "/api/newsroom-ask",
      "dest": "/api/newsroom-ask.js"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)\\.(.+)",
      "dest": "/$1.$2"
    },
    {
      "src": "/(.*)",
      "dest": "/$1.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "schedules": {
    "newsroom-daily": {
      "schedule": "7 16 * * *",
      "path": "/api/newsroom-run",
      "requestMethod": "GET"
    },
    "newsroom-triage": {
      "schedule": "37 16 * * *",
      "path": "/api/newsroom-triage",
      "requestMethod": "GET"
    }
  }
}
