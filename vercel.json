{
  "version": 2,
  "builds": [
    {
      "src": "api/navigator.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30,
        "includeFiles": [
          "constitution_data.json"
        ]
      }
    },
    {
      "src": "api/_navigator-sonnet-fallback-benchmark.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30,
        "includeFiles": [
          "constitution_data.json",
          "scripts/fixtures/navigator-fallback-cases.json"
        ]
      }
    },
    {
      "src": "api/_annotator-model-benchmark.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30,
        "includeFiles": [
          "constitution_data.json",
          "scripts/fixtures/annotator-ai-cases.json"
        ]
      }
    },
    {
      "src": "api/annotate.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30,
        "includeFiles": [
          "constitution_data.json"
        ]
      }
    },
    {
      "src": "api/crossroads.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30
      }
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "_site"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/navigator",
      "dest": "/api/navigator.js"
    },
    {
      "src": "/api/_navigator-sonnet-fallback-benchmark",
      "dest": "/api/_navigator-sonnet-fallback-benchmark.js"
    },
    {
      "src": "/api/_annotator-model-benchmark",
      "dest": "/api/_annotator-model-benchmark.js"
    },
    {
      "src": "/api/annotate",
      "dest": "/api/annotate.js"
    },
    {
      "src": "/api/crossroads",
      "dest": "/api/crossroads.js"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)\\.(.+)",
      "dest": "/$1.$2"
    },
    {
      "src": "/(.*)",
      "dest": "/$1.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
