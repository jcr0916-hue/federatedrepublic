{
  "schemaVersion": 1,
  "purpose": "Review-only production architecture boundary; not a deployable Cloudflare configuration",
  "releaseApproved": false,
  "productionReady": false,
  "allowedOAuthScopes": [
    "newsroom:read"
  ],
  "allowedOAuthTools": [
    "newsroom_list",
    "newsroom_read"
  ],
  "legacy": {
    "worker": "federated-republic-newsroom",
    "sourceEntrypoint": "src/index.ts",
    "bundle": "dist/worker.js",
    "operation": "preserve-unchanged",
    "requiredBindings": [
      "KEY_CORINDAL",
      "KEY_EDITOR",
      "KEY_FEDERAL",
      "KEY_KORDA",
      "KEY_VAREK",
      "NEWSROOM"
    ]
  },
  "issuer": {
    "workerName": "UNASSIGNED_DO_NOT_DEPLOY",
    "sourceEntrypoint": "src/issuer-candidate.ts",
    "bundle": "dist/issuer-candidate.js",
    "requiredBindings": [
      "ISSUER_ORIGIN",
      "ISSUER_CLIENT_ID",
      "ISSUER_CLIENT_SECRET_SHA256",
      "ISSUER_EDITOR_ID",
      "ISSUER_GITHUB_CLIENT_ID",
      "ISSUER_GITHUB_CLIENT_SECRET",
      "ISSUER_GRANTS",
      "ISSUER_GUARD",
      "ISSUER_REDIRECT_URI",
      "ISSUER_AUDIENCE",
      "ISSUER_RESOURCE_ID",
      "ISSUER_RESOURCE_SECRET_SHA256",
      "ISSUER_INGRESS_LIMIT",
      "NEWSROOM_METRICS",
      "ISSUER_ADMISSION_KEY",
      "ISSUER_TURNSTILE_SITE_KEY",
      "ISSUER_TURNSTILE_SECRET",
      "ISSUER_SESSION_KEY"
    ]
  },
  "resource": {
    "workerName": "UNASSIGNED_DO_NOT_DEPLOY",
    "sourceEntrypoint": "src/resource-s3-candidate.ts",
    "bundle": "dist/resource-s3-candidate.js",
    "requiredBindings": [
      "ISSUER",
      "R2_READ_ENDPOINT",
      "R2_READ_BUCKET",
      "R2_READ_ACCESS_KEY_ID",
      "R2_READ_SECRET_ACCESS_KEY",
      "RESOURCE_AUDIENCE",
      "RESOURCE_CLIENT_ID",
      "RESOURCE_ISSUER",
      "RESOURCE_VALIDATOR_ID",
      "RESOURCE_VALIDATOR_SECRET",
      "RESOURCE_INGRESS_LIMIT",
      "NEWSROOM_METRICS",
      "RESOURCE_ADMISSION_KEY"
    ]
  },
  "prohibitedOauthTools": [
    "newsroom_submit",
    "newsroom_review",
    "publish"
  ],
  "excludedBindingsOnResource": [
    "NEWSROOM",
    "KEY_CORINDAL",
    "KEY_EDITOR",
    "KEY_FEDERAL",
    "KEY_KORDA",
    "KEY_VAREK",
    "OAUTH_KV",
    "CHATGPT_CLIENT_ID"
  ],
  "requiresApprovalFor": [
    "merge-main",
    "production-deployment",
    "attach-production-r2",
    "rotate-production-secrets",
    "change-production-permissions",
    "revoke-live-grants",
    "configure-edge-rate-limiting"
  ],
  "monitoring": {
    "schema": "fixed-categorical-counters-v1",
    "issuerDataset": "NEW_DEDICATED_ISSUER_ANALYTICS_ENGINE_BINDING_REQUIRED",
    "resourceDataset": "NEW_DEDICATED_RESOURCE_ANALYTICS_ENGINE_BINDING_REQUIRED",
    "allowedFields": [
      "category",
      "surface",
      "count"
    ],
    "forbiddenFields": [
      "Authorization",
      "Cookie",
      "code",
      "state",
      "token",
      "refresh_token",
      "client_secret",
      "request URL",
      "IP address",
      "submission body"
    ],
    "status": "NOT_PROVISIONED_OR_TESTED",
    "mustVerifyBeforeRelease": true
  }
}
