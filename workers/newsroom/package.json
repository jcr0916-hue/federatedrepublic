    "build:resource-s3-candidate": "node scripts/build-resource-s3-candidate.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260730.1",
    "@types/node": "24.6.0",
    "cf": "1.0.0-beta.28",
    "esbuild": "0.25.10",
    "miniflare": "5.20261104.0-beta",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
