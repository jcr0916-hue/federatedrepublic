{
  "name": "federated-republic-newsroom-oauth",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.22.0 || ^26.12.0"
  },
  "scripts": {
    "test": "node --test --import tsx test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "build:test": "node scripts/build-test.mjs",
    "build:issuer-candidate": "node scripts/build-issuer-candidate.mjs",
