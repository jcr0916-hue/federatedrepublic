{% for group in navigation %}{% if group.url %}<a href="{% if group.url[0] != '/' and '://' not in group.url %}/{% endif %}{{ group.url }}">{{ group.label }}</a>{% else %}
<details class="nav-group"><summary>{{ group.label }}</summary><div class="nav-group-links">{% for label, url in group.links %}{% if page.url != '/scenarios.html' or url != 'crossroads.html' %}<a href="{% if url[0] != '/' and '://' not in url %}/{% endif %}{{ url }}"{% if page.url == '/' + url %} aria-current="page"{% endif %}>{{ label }}</a>{% endif %}{% endfor %}</div></details>
{% endif %}{% endfor %}