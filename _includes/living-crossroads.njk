<section class="living-crossroads" aria-labelledby="crossroads-heading">
  <div class="crossroads-eyebrow">An interactive series · Non-canon</div>
  <h2 id="crossroads-heading">Living Crossroads</h2>
  {% if crossroads.active %}
  <a class="crossroads-feature" href="{{ crossroads.url }}" aria-label="Play Living Crossroads: {{ crossroads.title }}">
  {% else %}
  <div class="crossroads-feature crossroads-inactive">
  {% endif %}
    <img class="crossroads-art" src="living-crossroads.jpg" width="1536" height="1024" alt="Stone paths branching toward illuminated doors of a civic assembly" loading="lazy" decoding="async">
    <div class="crossroads-caption">
      {% if crossroads.active %}
      <span class="crossroads-label">Now playing</span>
      <h3>{{ crossroads.title }}</h3>
      <p>{{ crossroads.description }}</p>
      <span class="crossroads-action">Play this crossroads &rarr;</span>
      {% else %}
      <p>A new crossroads will open here when the next story is ready.</p>
      {% endif %}
    </div>
  {% if crossroads.active %}</a>{% else %}</div>{% endif %}
</section>
