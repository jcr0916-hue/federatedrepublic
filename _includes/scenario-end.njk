{% set bridge = scenarioBridges[page.fileSlug] %}
{% if bridge %}
<section class="scenario-end related-rail" aria-labelledby="scenario-learning-title" data-related-rail>
  <div class="related-rail-head">
    <div>
      <span class="section-kicker">Continue the question</span>
      <h2 id="scenario-learning-title">What this tested</h2>
      <p>{{ bridge.summary }}</p>
    </div>
    <div class="related-rail-controls" aria-label="Related scenario material controls">
      <button class="related-rail-control" type="button" data-rail-prev aria-label="Show previous related items">←</button>
      <button class="related-rail-control" type="button" data-rail-next aria-label="Show more related items">→</button>
    </div>
  </div>
  <div class="related-rail-track" data-rail-track tabindex="0">
    {% for provision in bridge.provisions %}
    <article class="related-rail-card">
      <div class="related-rail-card-body">
        <span class="related-rail-kicker">Constitution</span>
        <h3><a href="annotated.html#{{ provision.ref | provisionAnchor }}">{{ provision.ref }} — {{ provision.label }}</a></h3>
        <p>Read the operative provision in the annotated Constitution.</p>
        <a class="related-rail-link" href="annotated.html#{{ provision.ref | provisionAnchor }}">Open provision →</a>
      </div>
    </article>
    {% endfor %}
    {% for link in bridge.links %}
    <article class="related-rail-card">
      <div class="related-rail-card-body">
        <span class="related-rail-kicker">{% if 'scenario-' in link.url %}Related scenario{% elif 'quicksheet' in link.url %}Quick reference{% elif 'diagram' in link.url %}Diagram{% elif 'dossier' in link.url or 'torenthia' in link.url %}Torenthia{% else %}Go deeper{% endif %}</span>
        <h3><a href="{{ link.url }}">{{ link.label }}</a></h3>
        <p>Continue from this scenario into a closely related part of the project.</p>
        <a class="related-rail-link" href="{{ link.url }}">Continue →</a>
      </div>
    </article>
    {% endfor %}
    <article class="related-rail-card">
      <div class="related-rail-card-body">
        <span class="related-rail-kicker">Scenario library</span>
        <h3><a href="scenarios.html">Browse all scenarios</a></h3>
        <p>Choose another constitutional pressure test by institution or question.</p>
        <a class="related-rail-link" href="scenarios.html">Browse the library →</a>
      </div>
    </article>
  </div>
</section>
<script src="related-rail.js"></script>
{% endif %}
