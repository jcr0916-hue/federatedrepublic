<aside class="related-world refresh-wrap" aria-label="Related public records"><h2>Follow this file</h2><div class="link-row">{% for file in currentFiles %}{% if file.id in worldArcs %}<a href="dossier-{{ file.id }}.html">{{ file.short }} dossier</a>{% endif %}{% endfor %}{% for name in worldJurisdictions %}<a href="torenthia-record.html?place={{ name }}">{{ name }}</a>{% endfor %}</div><div class="record-grid">{% for p in collections.world | relatedWorld(worldId) %}{% include "record-card.njk" %}{% endfor %}</div><div class="link-row">{% for ref in worldProvisions | take(5) %}<a href="annotated.html#{{ ref | provisionAnchor }}">{{ ref }}</a>{% endfor %}<a href="torenthia-record.html">Complete public archive →</a></div><div class="link-row">{% for p in collections.world %}{% if p.data.worldId == worldId %}{% if not loop.first %}<a href="{{ collections.world[loop.index0 - 1].url }}">← Previous in the public record</a>{% endif %}{% if not loop.last %}<a href="{{ collections.world[loop.index0 + 1].url }}">Next in the public record →</a>{% endif %}{% endif %}{% endfor %}</div></aside>