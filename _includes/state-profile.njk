<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="favicon.ico" sizes="any">
  <title>{{ stateName }} — The Federated Republic</title>
  <meta name="description" content="{{ description }}">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Jost:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="site.css">
  <style>
    .state-profile{max-width:900px;margin:100px auto 60px;padding:0 24px}
    .state-profile h1{font-family:'Cormorant Garamond',serif;font-size:clamp(3rem,8vw,5rem);margin:.4em 0}
    .state-profile h2{font-family:'Cormorant Garamond',serif;font-size:2rem;margin-top:2rem}
    .state-profile p,.state-profile li{line-height:1.8}
    .state-profile a{color:#765817}
    .state-kicker,.state-facts dt{font-family:'JetBrains Mono',monospace;font-size:.72rem;text-transform:uppercase;letter-spacing:.1em}
    .state-facts{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;padding:24px 0;border-block:1px solid var(--gold)}
    .state-facts dd{margin:8px 0 0;font-size:1.4rem}
    .state-profile blockquote{margin:24px 0;padding:4px 24px;border-left:3px solid var(--gold);font-family:'Cormorant Garamond',serif;font-size:1.5rem}
    .state-heading{display:flex;align-items:center;justify-content:space-between;gap:24px;margin:20px 0}.state-heading h1{margin:0}.state-flag{margin:0;width:210px;flex-shrink:0}.state-flag img{display:block;width:100%;height:auto;box-shadow:0 2px 10px #0002}.state-flag figcaption{font-size:.8rem;line-height:1.4;margin-top:8px}
    @media(max-width:600px){.state-heading{align-items:flex-start;flex-wrap:wrap}.state-flag{width:150px}}
    .state-coverage{padding-left:20px}.state-coverage li{margin:12px 0}
    .state-coverage small{display:block;opacity:.75}
    @media(max-width:600px){.state-facts{grid-template-columns:repeat(2,1fr)}}
  </style>
</head>
<body>
<a href="#main-content" class="skip-nav">Skip to main content</a>
<div id="site-nav"></div>
<main class="state-profile" id="main-content">
  <div role="navigation" aria-label="State navigation"><a href="torenthia.html">Torenthia</a> / States{% for s in statepages %} · <a href="{{ s.url }}"{% if s.name == stateName %} aria-current="page"{% endif %}>{{ s.name }}</a>{% endfor %}</div>
  {% for s in statepages %}{% if s.name == stateName %}
  <p class="state-kicker">{{ s.char }}</p>
  <div class="state-heading">
    <h1>{{ s.name }}</h1>
    {% if stateFlag %}<figure class="state-flag"><a href="{{ stateFlag }}" aria-label="View {{ s.name }} flag at full size"><img src="{{ stateFlag }}" width="1536" height="1024" alt="{{ stateFlagAlt }}"></a><figcaption>Flag of {{ s.name }}</figcaption></figure>{% endif %}
  </div>
  <dl class="state-facts">
    <div><dt>Population</dt><dd>{{ s.pop }}M</dd></div>
    <div><dt>Federal Senate</dt><dd>{{ s.senate }} seats</dd></div>
    <div><dt>Federal Assembly</dt><dd>{{ s.assembly }} seats</dd></div>
    <div><dt>State audit</dt><dd>{{ s.audit }}</dd></div>
  </dl>
  {% endif %}{% endfor %}
  {{ content | safe }}
  <h2>Read the Constitution</h2>
  <p><a href="State%20Constitutions/{{ stateName | lower }}-state-constitution.md">{{ stateName }} State Constitution (Markdown)</a>. This profile summarizes the State text; the <a href="annotated.html">federal Constitution</a> governs wherever the two conflict.</p>
  <h2>In the public record</h2>
  <ul class="state-coverage">
  {% for piece in collections.world | stateCoverage(stateName) %}
    <li><a href="{{ piece.url }}">{{ piece.data.worldTitle }}</a><small>{{ piece.data.worldOutlet }} · {{ piece.data.worldDate }}</small></li>
  {% endfor %}
  </ul>
</main>
{% include "footer.njk" %}
<script src="nav.js"></script>
</body>
</html>
